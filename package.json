{
  "name": "developer-productivity-suite",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client",
    "lint:client": "npm run lint -w client",
    "lint:server": "npm run lint -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "keywords": [
    "developer-tools",
    "saas",
    "productivity",
    "code-generator"
  ],
  "license": "ISC"
}
